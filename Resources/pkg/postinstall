#!/bin/sh
# Runs as root after Installer has copied Netbar into /Applications.
set -u

APP="${3%/}/Applications/Netbar.app"

# Start the new version for the user at the screen (quitting the old one first).
user="$(/usr/bin/stat -f %Su /dev/console)"
if [ -n "$user" ] && [ "$user" != "root" ] && [ "$user" != "loginwindow" ]; then
    uid="$(/usr/bin/id -u "$user")"
    /usr/bin/pkill -x -u "$uid" Netbar 2>/dev/null && /bin/sleep 1
    /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/open "$APP" || true
fi
exit 0
